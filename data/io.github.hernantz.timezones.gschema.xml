<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.hernantz.timezones" path="/io/github/hernantz/timezones/">
    <key name="fmt-24h" type="b">
      <default>true</default>
      <summary>Use 24-hour time format</summary>
    </key>

    <key name="theme-mode" type="s">
      <default>'system'</default>
      <summary>Theme mode: system, light, dark</summary>
      <description>Controls Adw color scheme override.</description>
    </key>

    <key name="show-offsets" type="b">
      <default>true</default>
      <summary>Show offset pills on non-reference rows</summary>
      <description>The offset is measured from the reference row, not from UTC.</description>
    </key>

    <key name="show-daynight" type="b">
      <default>true</default>
      <summary>Show day / night colors on timeline cells</summary>
    </key>
  </schema>
</schemalist>
