#. Translators: a city and the user's own label for it, as in
#. "Cairo (Family)".
#: src/share.py:40
#, python-brace-format
msgid "{city} ({label})"
msgstr "{city} ({label})"

#: src/share.py:147
msgid "Meeting"
msgstr "Riunione"

#. Translators: the title of a saved calendar event, as in
#. "Meeting · 15:00 London".
#: src/share.py:152
#, python-brace-format
msgid "Meeting · {time} {city}"
msgstr "Riunione · {time} {city}"

#. Translators: a state or province and the country it is in, as in
#. "Washington, United States".
#: src/tzinfo_helpers.py:338
#, python-brace-format
msgctxt "state in country"
msgid "{state}, {country}"
msgstr "{state}, {country}"

#: src/tzinfo_helpers.py:393
msgctxt "time standard"
msgid "Coordinated Universal Time"
msgstr "Tempo coordinato universale"

#. Translators: a difference between two clocks, in hours, as in "+2h" or
#. "−5.5h". {sign} is + or −; add a space or change the unit to suit.
#: src/tzinfo_helpers.py:595
#, python-brace-format
msgctxt "offset in hours"
msgid "{sign}{hours}h"
msgstr "{sign}{hours} h"

#. Translators: a zone's offset from UTC, as in "UTC−3" or "UTC+5:30".
#. {offset} is the signed offset; translate "UTC" if your language uses
#. another abbreviation for it.
#: src/tzinfo_helpers.py:612
#, python-brace-format
msgctxt "UTC offset"
msgid "UTC{offset}"
msgstr "UTC{offset}"

#: src/tzinfo_helpers.py:746
#, python-brace-format
msgid ""
"Clocks in {city} move back {span} at {time} on {date} — {repeated} occurs "
"twice"
msgstr ""
"A {city} gli orologi vengono portati indietro di {span} alle {time} del "
"{date}: le {repeated} si ripetono due volte"

#: src/tzinfo_helpers.py:757
#, python-brace-format
msgid ""
"Clocks in {city} move forward {span} at {time} on {date} — {time} does not "
"occur"
msgstr ""
"A {city} gli orologi vengono portati avanti di {span} alle {time} del "
"{date}: le {time} non esistono"

