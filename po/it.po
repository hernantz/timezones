#: data/io.github.hernantz.timezones.desktop:3
#: data/appdata/io.github.hernantz.timezones.metainfo.xml:6 src/app.py:101
#: src/main_window.py:126 src/main_window.py:1020
msgid "Timezones"
msgstr "Fusi orari"

#: data/io.github.hernantz.timezones.desktop:4
#: data/appdata/io.github.hernantz.timezones.metainfo.xml:7
msgid "Compare times around the world"
msgstr "Confronta l'ora in tutto il mondo"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:10
msgid ""
"Keep track of the time in the cities that matter to you. Timezones shows a "
"row per city on a shared timeline, so a glance tells you who is asleep, who "
"is at work, and what an hour of your day looks like everywhere at once."
msgstr ""
"Tieni d'occhio l'ora nelle città che ti stanno a cuore. Fusi orari mostra "
"una riga per città su una linea temporale condivisa, così con un colpo "
"d'occhio capisci chi dorme, chi è al lavoro e come appare un'ora della tua "
"giornata ovunque nello stesso momento."

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:15
msgid "Features:"
msgstr "Caratteristiche:"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:17
msgid "Scrub the timeline to read the same moment in every city"
msgstr ""
"Scorri la linea temporale per leggere lo stesso momento in ogni città"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:18
msgid ""
"Daylight shading, so working hours and the middle of the night are obvious"
msgstr ""
"Sfumature di luce diurna, per distinguere a colpo d'occhio l'orario di "
"lavoro e il cuore della notte"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:19
msgid "Pick any date to plan ahead across daylight saving changes"
msgstr ""
"Scegli una data qualsiasi per pianificare attraverso i cambi di ora legale"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:20
msgid "Share a time as a calendar invitation or as text"
msgstr "Condividi un orario come invito del calendario o come testo"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:21
msgid "12- or 24-hour clocks, light and dark themes"
msgstr "Orologi a 12 o 24 ore, temi chiaro e scuro"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:27
msgid "An hour parked on the shared timeline"
msgstr "Un'ora fissata sulla linea temporale condivisa"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:31
msgid "Four cities across a full day, with daylight shading"
msgstr ""
"Quattro città nell'arco di un'intera giornata, con sfumature di luce diurna"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:35
msgid "Searching the timezone list"
msgstr "Ricerca nell'elenco dei fusi orari"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:39
msgid "The stacked layout at phone width"
msgstr "Il layout impilato a larghezza smartphone"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:43
msgid "Appearance, time format and view options"
msgstr "Aspetto, formato dell'ora e opzioni di visualizzazione"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:47
msgid "The same list in the dark theme"
msgstr "La stessa lista con il tema scuro"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:68
msgid "A smaller release with one change of behavior and one fix:"
msgstr ""
"Una versione più piccola, con una modifica del comportamento e una "
"correzione:"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:70
msgid ""
"New installs start with an empty list instead of a preset selection of cities"
msgstr ""
"Le nuove installazioni partono con una lista vuota invece che con una "
"selezione predefinita di città"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:71
msgid "Long city descriptions no longer break the layout of the add dialog"
msgstr ""
"Le descrizioni lunghe delle città non rompono più il layout della finestra "
"di aggiunta"

#: data/appdata/io.github.hernantz.timezones.metainfo.xml:77
msgid "First release."
msgstr "Prima versione."

